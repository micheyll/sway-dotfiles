{
   "action": {
      "default_icon": {
         "128": "./images/logo_128.png",
         "16": "./images/logo_16.png",
         "32": "./images/logo_32.png",
         "48": "./images/logo_48.png",
         "512": "./images/logo_512.png",
         "64": "./images/logo_64.png"
      },
      "default_popup": "popup.html",
      "default_title": "StarKey Wallet"
   },
   "background": {
      "service_worker": "scripts/background.js"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "scripts/contentScript.js" ],
      "matches": [ "http://localhost:3000/", "file://*/*", "http://*/*", "https://*/*" ],
      "run_at": "document_start"
   } ],
   "description": "StarKey Wallet for Supra, Ethereum, Solana, and more",
   "differential_fingerprint": "1.365acb2ca6d16cadfe690c9bdef33b5946b4134a6b532102d3c84a53973e4914",
   "externally_connectable": {
      "matches": [ "\u003Call_urls>" ]
   },
   "host_permissions": [ "http://localhost:3000/", "file://*/*", "http://*/*", "https://*/*" ],
   "icons": {
      "128": "./images/logo_128.png",
      "16": "./images/logo_16.png",
      "32": "./images/logo_32.png",
      "48": "./images/logo_48.png",
      "512": "./images/logo_512.png",
      "64": "./images/logo_64.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "StarKey Wallet - The official wallet for Supra",
   "permissions": [ "storage", "unlimitedStorage", "clipboardWrite", "alarms", "identity", "tabs", "activeTab", "scripting", "system.display" ],
   "short_name": "StarKey Wallet",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.3.2",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "/images/*" ]
   }, {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "scripts/injectScript.js" ]
   } ]
}
